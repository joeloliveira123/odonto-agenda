# ==============================================================================
# Odonto Agenda — Variáveis de Ambiente (.env.example)
# Copie para .env.local quando conectar a um projeto Supabase ou provedor de IA.
# O modo demonstração público funciona sem nenhuma dessas variáveis preenchidas.
# ==============================================================================

# Supabase (PostgreSQL, Auth e Storage)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Identificação de Tenant padrão (opcional)
NEXT_PUBLIC_DEFAULT_TENANT_SLUG="sua-odontologia"

# Provedor de IA opcional (Odonto AI — Fase 5)
ODONTO_AI_PROVIDER=""
ODONTO_AI_API_KEY=""
